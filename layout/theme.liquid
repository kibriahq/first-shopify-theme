<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% comment %}
      Font preloading:
      1. Preconnect to font CDN for faster connection
      2. Preload only the critical font variant (base weight)
      3. Additional variants load on-demand via @font-face
    {% endcomment %}
    {% unless settings.type_primary_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

      {% comment %} Preload the base font variant for initial page render {% endcomment %}
      {{ settings.type_primary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {% # Load and preload the critical CSS %}
    {% comment %} {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }} {% endcomment %}
    {{ 'theme.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

     <script
        id="tailwind-config">tailwind.config = { darkMode: "class", theme: { extend: { "colors": { "surface-container": "#e5eeff", "surface-dim": "#cbdbf5", "error-container": "#ffdad6", "tertiary-fixed": "#e0e3e5", "outline-variant": "#c6c6cd", "surface-container-lowest": "#ffffff", "on-error-container": "#93000a", "secondary": "#2b6954", "on-primary-container": "#7c839b", "on-primary-fixed": "#131b2e", "on-tertiary-fixed": "#191c1e", "on-tertiary": "#ffffff", "on-primary-fixed-variant": "#3f465c", "surface": "#f8f9ff", "primary": "#000000", "surface-bright": "#f8f9ff", "on-secondary": "#ffffff", "surface-variant": "#d3e4fe", "inverse-surface": "#213145", "on-background": "#0b1c30", "secondary-fixed": "#b0f0d6", "secondary-fixed-dim": "#95d3ba", "tertiary": "#000000", "surface-container-highest": "#d3e4fe", "secondary-container": "#adedd3", "background": "#f8f9ff", "outline": "#76777d", "surface-tint": "#565e74", "on-surface": "#0b1c30", "on-secondary-container": "#306d58", "surface-container-high": "#dce9ff", "tertiary-container": "#191c1e", "inverse-on-surface": "#eaf1ff", "tertiary-fixed-dim": "#c4c7c9", "on-tertiary-fixed-variant": "#444749", "on-error": "#ffffff", "primary-fixed": "#dae2fd", "on-tertiary-container": "#818486", "surface-container-low": "#eff4ff", "error": "#ba1a1a", "on-surface-variant": "#45464d", "primary-fixed-dim": "#bec6e0", "on-primary": "#ffffff", "inverse-primary": "#bec6e0", "on-secondary-fixed": "#002117", "on-secondary-fixed-variant": "#0b513d", "primary-container": "#131b2e" }, "borderRadius": { "DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "full": "9999px" }, "spacing": { "margin-mobile": "16px", "gutter": "24px", "section-gap": "80px", "unit": "8px", "container-max": "1280px" }, "fontFamily": { "body-md": ["Inter"], "headline-md": ["Inter"], "label-sm": ["Inter"], "body-lg": ["Inter"], "display-lg": ["Inter"], "accent-italic": ["Source Serif 4"], "display-lg-mobile": ["Inter"] }, "fontSize": { "body-md": ["16px", { "lineHeight": "24px", "fontWeight": "400" }], "headline-md": ["24px", { "lineHeight": "32px", "letterSpacing": "-0.01em", "fontWeight": "600" }], "label-sm": ["14px", { "lineHeight": "20px", "letterSpacing": "0.05em", "fontWeight": "500" }], "body-lg": ["18px", { "lineHeight": "28px", "fontWeight": "400" }], "display-lg": ["48px", { "lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "700" }], "accent-italic": ["18px", { "lineHeight": "28px", "fontWeight": "400" }], "display-lg-mobile": ["32px", { "lineHeight": "40px", "letterSpacing": "-0.01em", "fontWeight": "700" }] } } } }</script>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;family=Source+Serif+4:ital@1&amp;display=swap"
        rel="stylesheet">
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
        rel="stylesheet">
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet">

    {{ content_for_header }}
  </head>

  <body class="bg-surface font-body-md text-on-surface">
    {% sections 'header-group' %}

    {{ content_for_layout }}

    {% sections 'footer-group' %}
  </body>
</html>
