<footer class="w-full bg-surface-container-low pt-section-gap pb-gutter mt-section-gap">
  <div class="container mx-auto px-margin-mobile lg:px-gutter">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-gutter mb-16">
      <div class="flex flex-col gap-4">
        <h4 class="font-headline-md text-label-sm uppercase tracking-widest text-primary">Shop</h4>
        <nav class="flex flex-col gap-3">
          {% for link in linklists['footer-shop'].links %}
            <a
              class="text-body-md text-on-surface-variant hover:text-primary transition-colors"
              href="{{ link.url }}"
            >
              {{- link.title -}}
            </a>
          {% endfor %}
        </nav>
      </div>
      <div class="flex flex-col gap-4">
        <h4 class="font-headline-md text-label-sm uppercase tracking-widest text-primary">Support</h4>
        <nav class="flex flex-col gap-3">
          {% for link in linklists['footer-support'].links %}
            <a
              class="text-body-md text-on-surface-variant hover:text-primary transition-colors"
              href="{{ link.url }}"
            >
              {{- link.title -}}
            </a>
          {% endfor %}
        </nav>
      </div>
      <div class="lg:col-span-2 flex flex-col gap-6">
        <h4 class="font-headline-md text-label-sm uppercase tracking-widest text-primary">Newsletter</h4>
        <p class="text-body-md text-on-surface-variant">
          Be the first to receive updates on new collections and exclusive offers.
        </p>
        {% form 'customer', class: 'flex flex-col sm:flex-row gap-2' %}
          {% if form.posted_successfully? %}
            <p class="text-green-500">Thank you for subscribing!</p>
          {% endif %}

          {{ form.errors | default_errors }}
          <input
            class="flex-1 bg-surface-container-lowest border border-outline-variant px-4 py-3 text-body-md focus:border-primary outline-none transition-all"
            placeholder="Email address"
            type="email"
            name="contact[email]"
            required
            autocomplete="email"
          >
          
          <input
            type="hidden"
            name="contact[tags]"
            value="newsletter"
          />

          <button
            class="bg-primary text-on-primary px-8 py-3 font-label-sm uppercase tracking-widest hover:bg-on-background transition-all"
            type="submit"
          >
            Subscribe
          </button>
        {% endform %}
      </div>
    </div>
    <div
      class="border-t border-outline-variant pt-8 flex flex-col md:flex-row items-center justify-between gap-6"
    >
      <div class="flex gap-6">
        <a
          class="text-on-surface-variant hover:text-primary transition-colors"
          href="#"
          ><span class="material-symbols-outlined">public</span></a
        ><a
          class="text-on-surface-variant hover:text-primary transition-colors"
          href="#"
          ><span
            class="material-symbols-outlined"
            >share</span
          ></a
        ><a
          class="text-on-surface-variant hover:text-primary transition-colors"
          href="#"
          ><span
            class="material-symbols-outlined"
            >mail</span
          ></a
        >
      </div>
      <p class="text-label-sm text-on-surface-variant">
        © 2024 LUMINA. All rights reserved. Crafted for curated excellence.
      </p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    }
  ]
}
{% endschema %}
