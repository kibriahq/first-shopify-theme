<div class="announcement-bar">
    <p>{{ section.settings.announcement_text }}</p>
</div>

{% style %}
  .announcement-bar {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 1rem;
    border-bottom: 1px solid #ccc;
  }
{% endstyle %}

{% schema %}
    {
        "name": "Announcement Bar",
        "settings": [
            {
                "type": "text",
                "id": "announcement_text",
                "label": "Announcement Text"
            }
        ],
    }
{% endschema %}