<header
  class="fixed top-0 w-full z-50 bg-surface-container-lowest/80 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)]"
>
  <div class="h-20 container mx-auto px-margin-mobile lg:px-gutter flex items-center justify-between">
    <div class="flex items-center gap-2 flex-1">
      <img
        alt="Logo"
        class="h-12 w-auto object-contain"
        src="{{ 'logo.png' | asset_url }}"
        width="300"
        height="100"
      >
    </div>
    <nav
      class="hidden md:flex items-center gap-8 flex-[2] justify-center text-label-sm font-label-sm"
      data-active-classes="text-primary font-bold"
    >
      {% for link in section.settings.menu.links %}
        <a
          class="text-on-surface-variant hover:text-on-surface transition-colors uppercase tracking-widest {%  if link.active %} font-bold {% endif %}"
          data-path="collections"
          href="{{ link.url }}"
        >
          {{ link.title }}
        </a>
      {% endfor %}
    </nav>
    <div class="flex items-center justify-end gap-5 flex-1">
      <button
        class="text-on-surface-variant hover:text-primary transition-colors"
      >
        <img
          alt="Search"
          class="w-6 h-6"
          src="{{ 'search-icon.svg' | asset_url }}"
          height="24"
          width="24"
        >
      </button>
      <button
        class="text-on-surface-variant hover:text-primary transition-colors"
      >
        <img
          alt="Search"
          class="w-6 h-6"
          src="{{ 'heart-icon.svg' | asset_url }}"
          height="24"
          width="24"
        ></button
      ><a
        href="/cart"
        class="relative text-on-surface-variant hover:text-primary transition-colors"
      >
        <img
          alt="Search"
          class="w-6 h-6"
          src="{{ 'cart-icon.svg' | asset_url }}"
          height="24"
          width="24"
        >
        <span
          id="cart-count"
          class="absolute -top-1 -right-1 flex h-4 w-4 items-center justify-center rounded-full bg-secondary text-[10px] text-on-secondary font-bold"
        >
          0
        </span>
      </a>

      <button
        class="ml-2 border border-outline-variant rounded-full p-0.5 hover:border-primary transition-all"
      >
        <img
          alt="Profile"
          class="w-7 h-7 rounded-full object-cover"
          src="https://lh3.googleusercontent.com/aida-public/AB6AXuAQ9MKBubJ9S8jG5XCjZTkXT_MqsZefFkR790RYkN-AvrrUStcZbRSGwJAF1Ful5brz1MfVeew5R7lEBD4Z6rYl5gNtZuLU0teSaxx3IuAFlE8rewGuqk6DW2sovIvuVTgMQjPhWKaPVQ3bjnVUeWUrfJ6YsSbwAaQjXWMKUZXdh_S2_7V6ysaDlOyTYdgCf-Wh-VT2ZLIasDYGf4WykgF7WpC37hnjBCUjWbiEPZE_5PCieZw0zTnIZA"
          height="24"
          width="24"
        >
      </button>
    </div>
  </div>
</header>

{% stylesheet %}
  header {
    height: 5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  header a {
    position: relative;
    text-decoration: none;
    color: var(--color-foreground);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  header a sup {
    position: absolute;
    left: 100%;
    overflow: hidden;
    max-width: var(--page-margin);
  }
  header svg {
    width: 2rem;
  }
  header .header__menu,
  header .header__icons {
    display: flex;
    gap: 1rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
