<section class="w-full max-w-container-max mx-auto px-margin-mobile lg:px-gutter pb-section-gap">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
    <div class="lg:col-span-4 lg:sticky lg:top-32">
      <h2
        class="font-display-lg-mobile text-display-lg-mobile md:font-display-lg md:text-display-lg text-primary uppercase tracking-tighter mb-6"
      >
        New<br>
        Arrivals
      </h2>
      <p class="font-body-md text-body-md text-on-surface-variant mb-8">
        The latest additions to our curated catalog, featuring seasonal textures and innovative forms from our partnered
        artisans.
      </p>
      <a
        class="inline-block border-b border-primary pb-1 font-label-sm text-label-sm text-primary uppercase tracking-widest hover:text-surface-tint hover:border-surface-tint transition-colors"
        href="#"
      >
        Shop All New In
      </a>
    </div>
    <div class="lg:col-span-8 grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-16">
      <!-- Product Card 1 -->
      {% for product in section.settings['new-arrivals-collection'].products limit: 4 %}
        <a href="{{ product.url }}" class="group cursor-pointer flex flex-col">
          <div
            class="relative aspect-[3/4] mb-6 bg-surface-container-lowest overflow-hidden shadow-md hover:shadow-2xl transition-all duration-500 rounded-lg"
          >
            <img
              class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700"
              data-alt="A delicate, sculptural vase made of thin, unglazed porcelain with a jagged, organic rim, resembling a broken eggshell. Minimalist and fragile."
              src="{{ product.featured_image | image_url }}"
              height="100%"
              width="100%"
            >
          </div>
          <div class="flex justify-between items-start">
            <div>
              <h4 class="font-headline-md text-[18px] leading-tight text-primary mb-1">{{ product.title }}</h4>
              <p class="font-body-md text-body-md text-on-surface-variant">{{ product.collections.first.title }}</p>
            </div>
            <p class="font-label-sm text-label-sm text-primary pt-1">{{ product.price | money }}</p>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "New Arrivals",
  "settings": [
    {
      "type": "collection",
      "id": "new-arrivals-collection",
      "label": "New Arrivals Collection"
    }
  ]
}
{% endschema %}
