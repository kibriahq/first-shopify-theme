<form
  action="{{ routes.cart_url }}"
  method="post"
  class="pt-20 max-w-container-max mx-auto w-full px-margin-mobile lg:px-gutter py-section-gap"
>
  <div class="flex flex-col gap-4 mb-12">
    <h1 class="font-display-lg text-display-lg tracking-tighter text-primary">Your Cart</h1>
    <p class="font-body-lg text-body-lg text-on-surface-variant">
      <span
        class="font-label-sm text-label-sm uppercase tracking-widest text-primary mr-2"
      >
        {{- cart.item_count }} Items</span
      >
      Eligible for complimentary shipping.
    </p>
  </div>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-gutter">
    <!-- Cart Items -->
    <div class="lg:col-span-8 flex flex-col">
      <div class="hidden md:grid grid-cols-12 gap-4 pb-4 border-b border-outline-variant/30 mb-8">
        <div class="col-span-6 font-label-sm text-label-sm text-on-surface-variant uppercase tracking-widest">
          Product
        </div>
        <div
          class="col-span-2 text-center font-label-sm text-label-sm text-on-surface-variant uppercase tracking-widest"
        >
          Quantity
        </div>
        <div
          class="col-span-2 text-right font-label-sm text-label-sm text-on-surface-variant uppercase tracking-widest"
        >
          Price
        </div>
        <div
          class="col-span-2 text-right font-label-sm text-label-sm text-on-surface-variant uppercase tracking-widest"
        >
          Total
        </div>
      </div>
      <div class="flex flex-col gap-8">
        <!-- Item 1 -->
        {% for item in cart.items %}
          <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center group">
            <div class="md:col-span-6 flex gap-6 items-center">
              <div
                class="relative w-32 aspect-[4/5] bg-surface-container overflow-hidden group-hover:shadow-lg transition-shadow duration-300"
              >
                <img
                  class="w-full h-full object-cover"
                  data-alt="A minimalist overhead shot of a sleek, matte black ceramic vase on a textured linen cloth, softly lit to emphasize subtle curves and high-end craftsmanship."
                  src="{{ item.image | img_url: '400x' }}"
                  height="400"
                  width="400"
                >
              </div>
              <div class="flex flex-col gap-2">
                <h3 class="font-headline-md text-body-lg text-primary">{{ item.title }}</h3>
                <p class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-widest">
                  {{ item.variant_title }}
                </p>
                <a
                  href="{{ item.url_to_remove }}"
                  class="text-left font-label-sm text-label-sm text-on-surface-variant hover:text-error transition-colors mt-2 w-fit"
                >
                  Remove
                </a>
              </div>
            </div>
            <div class="md:col-span-2 flex justify-start md:justify-center">
              <div
                class="flex items-center bg-surface-container-low rounded-full px-4 py-2 border border-outline-variant/50"
              >
                <button type="button"
                  class="text-on-surface-variant hover:text-primary transition-colors focus:outline-none"
                >
                  <span
                    class="material-symbols-outlined text-[18px]"
                    >remove</span
                  >
                </button>
                <span class="w-8 text-center font-body-md text-body-md text-primary">{{ item.quantity }}</span>
                <button type="button"
                  class="text-on-surface-variant hover:text-primary transition-colors focus:outline-none"
                >
                  <span
                    class="material-symbols-outlined text-[18px]"
                    >add</span
                  >
                </button>
              </div>
            </div>
            <div class="hidden md:block md:col-span-2 text-right font-body-lg text-body-lg text-on-surface-variant">
              {{ item.price | money }}
            </div>
            <div class="md:col-span-2 text-left md:text-right font-headline-md text-headline-md text-primary">
              {{ item.line_price | money }}
            </div>
          </div>

          {% unless forloop.last %}
            <div class="w-full h-[1px] bg-outline-variant/20"></div>
          {% endunless %}
        {% endfor %}
      </div>
    </div>
    <!-- Order Summary -->
    <div class="lg:col-span-4">
      <div
        class="bg-surface-container-lowest p-8 shadow-[0_8px_30px_rgb(0,0,0,0.04)] sticky top-32 flex flex-col gap-8"
      >
        <h2 class="font-headline-md text-headline-md text-primary tracking-tighter">Order Summary</h2>
        <div class="flex flex-col gap-4">
          <div class="flex justify-between items-center">
            <span class="font-body-md text-body-md text-on-surface-variant">Subtotal</span>
            <span class="font-body-md text-body-md text-primary">{{ cart.total_price | money }}</span>
          </div>
          <div class="flex justify-between items-center">
            <span class="font-body-md text-body-md text-on-surface-variant flex items-center gap-2"
              >Shipping
              <span
                class="material-symbols-outlined text-[16px] text-outline"
                >help</span
              ></span
            >
            <span class="font-body-md text-body-md text-primary">
              {%- if cart.total_shipping %}{{ cart.total_shipping | money }}{% else %}Calculated at checkout{% endif -%}
            </span>
          </div>
        </div>
        <div class="w-full h-[1px] bg-outline-variant/30"></div>
        <div class="flex flex-col gap-3">
          <label class="font-label-sm text-label-sm text-primary uppercase tracking-widest"
            >Gift card or discount code</label
          >
          <div class="flex gap-2">
            <input
              class="flex-1 bg-surface-container-low border border-outline-variant/50 px-4 py-3 font-body-md text-body-md focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary transition-all"
              placeholder="Enter code"
              type="text"
            >
            <button
              class="px-6 py-3 border border-primary text-primary font-label-sm text-label-sm uppercase tracking-widest hover:bg-primary hover:text-on-primary transition-colors"
            >
              Apply
            </button>
          </div>
        </div>
        <div class="w-full h-[1px] bg-outline-variant/30"></div>
        <div class="flex justify-between items-end">
          <span class="font-headline-md text-body-lg text-primary">Estimated Total</span>
          <span class="font-display-lg-mobile text-display-lg-mobile text-primary tracking-tighter">
            {{- cart.total_price | money -}}
          </span>
        </div>
        <p class="font-body-md text-label-sm text-on-surface-variant text-sm mt-[-16px]">
          Taxes calculated at checkout.
        </p>
        <button
          type="submit"
          class="w-full bg-primary text-on-primary py-4 font-label-sm text-label-sm uppercase tracking-widest hover:bg-inverse-surface transition-colors flex items-center justify-center gap-2 group"
        >
          Proceed to Checkout
          <span
            class="material-symbols-outlined group-hover:translate-x-1 transition-transform"
            >arrow_forward</span
          >
        </button>
        <div class="flex items-center justify-center gap-4 mt-2">
          <span class="material-symbols-outlined text-outline-variant" title="Secure Payment">lock</span>
          <span class="material-symbols-outlined text-outline-variant" title="Verified">verified_user</span>
          <span class="material-symbols-outlined text-outline-variant" title="Fast Shipping">local_shipping</span>
        </div>
      </div>
    </div>
  </div>
</form>

{% schema %}
{
  "name": "t:general.cart",
  "settings": []
}
{% endschema %}
