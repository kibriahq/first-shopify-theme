<section
  class="w-full bg-surface-container-low/40 border-b border-outline-variant/20 overflow-hidden relative"
>
  <div
    class="max-w-container-max mx-auto px-margin-mobile lg:px-gutter py-12 lg:py-16 min-h-[640px] grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center"
  >
    <div class="lg:col-span-6 flex flex-col justify-center items-start pr-0 lg:pr-6 z-10">
      <div
        class="inline-flex items-center gap-2 px-3 py-1 mb-6 rounded-full bg-surface-container-highest/60 text-primary text-label-sm font-label-sm tracking-widest uppercase text-[11px] font-semibold"
      >
        <span class="">Spring / Summer 2025</span
        ><span
          class="w-1.5 h-1.5 rounded-full bg-secondary"
        ></span
        ><span class="">Curated Arrival</span>
      </div>
      <h1
        class="font-display-lg text-4xl lg:text-[54px] font-semibold text-primary uppercase tracking-tight leading-[1.08] mb-6"
      >
        {{ section.settings.heading_line_1 -}}
        <br>
        <span
          class="font-normal italic font-accent-italic text-on-surface-variant lowercase"
        >
          {{- section.settings.heading_line_2 -}}</span
        ><br>
        {{ section.settings.heading_line_3 }}
      </h1>
      <p class="font-body-lg text-body-lg text-on-surface-variant mb-8 max-w-md leading-relaxed">
        {{ section.settings.description_text }}
      </p>
      <div class="flex flex-wrap items-center gap-4 w-full sm:w-auto">
        <a
          href="{{ section.settings['button_link_1'] }}"
          class="inline-flex items-center justify-center bg-primary text-on-primary px-8 py-4 font-label-sm text-label-sm uppercase tracking-widest hover:bg-neutral-800 transition-all rounded shadow-sm hover:shadow-md"
        >
          {{- section.settings.button_text_1 -}}</a
        ><a
          href="{{ section.settings['button_link_2'] }}"
          class="inline-flex items-center justify-center gap-2 border border-outline-variant/60 text-primary px-7 py-4 font-label-sm text-label-sm uppercase tracking-widest hover:border-primary transition-all rounded"
        >
          {{- section.settings.button_text_2 }}
          <span class="material-symbols-outlined text-[18px]">arrow_forward</span></a
        >
      </div>
      <div class="grid grid-cols-3 gap-6 pt-10 mt-10 border-t border-outline-variant/30 w-full">
        {% for block in section.blocks %}
          <div>
            <p class="font-headline-md text-xl font-bold text-primary">{{ block.settings.heading }}</p>
            <p class="text-xs text-on-surface-variant uppercase tracking-wider mt-0.5">
              {{ block.settings.description }}
            </p>
          </div>
        {% endfor %}
      </div>
    </div>
    <div class="lg:col-span-6 relative">
      <div
        class="relative aspect-[4/5] rounded-xl overflow-hidden shadow-2xl border border-outline-variant/20 group"
      >
        <img
          src="/cdn/shop/files/diy-organic-candle_925x_6c627f3d-c9ea-4f1b-a36e-0ce8fd0c15a7.jpg?v=1788086416&width=925"
          alt="Architectural living room interior by LUMINA"
          class="w-full h-full object-cover rounded-xl transition-transform duration-700 group-hover:scale-105"
          height="100%"
          width="100%"
        >
        <div
          class="absolute bottom-6 left-6 bg-surface-container-lowest/90 backdrop-blur-md p-4 rounded-lg shadow-lg border border-white/40 max-w-[240px] hidden sm:flex items-center gap-3.5"
        >
          <div
            class="w-10 h-10 rounded-md bg-surface-container-high flex items-center justify-center flex-shrink-0 text-primary"
          >
            <span class="material-symbols-outlined text-[20px]">chair</span>
          </div>
          <div>
            <p class="text-xs font-semibold text-primary">The Curvature Sofa</p>
            <p class="text-[11px] text-on-surface-variant font-medium">Bespoke Boucle in Sand</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading first line",
      "default": "Quiet Luxury"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading italic line",
      "default": "for the"
    },
    {
      "type": "text",
      "id": "heading_line_3",
      "label": "Heading last line",
      "default": "Modern Sanctuary"
    },
    {
      "type": "textarea",
      "id": "description_text",
      "label": "Description Text",
      "default": "Discover sculptural furniture, tactile textiles, and refined objects crafted by master artisans to bring serene permanence to everyday living."
    },
    {
      "type": "text",
      "id": "button_text_1",
      "label": "First button text",
      "default": "Explore Collection"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "First button link"
    },
    {
      "type": "text",
      "id": "button_text_2",
      "label": "Second button text",
      "default": "View Lookbook"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Second button link"
    }
  ],
  "max_blocks": 3,
  "blocks": [
    {
      "type": "hero_info",
      "name": "Hero Info",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading Text"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        {
          "type": "hero_info",
          "settings": {
            "heading": "100%",
            "description": "Sustainably Sourced"
          }
        },
        {
          "type": "hero_info",
          "settings": {
            "heading": "Limited",
            "description": "Artisan Editions"
          }
        },
        {
          "type": "hero_info",
          "settings": {
            "heading": "Global",
            "description": "White Glove Care"
          }
        }
      ]
    }
  ]
}
{% endschema %}
