<section
  class="relative w-full h-[85vh] min-h-[600px] flex items-center bg-surface-container-low overflow-hidden bg-surface-container-lowest"
>
  <div
    class="absolute inset-0 bg-cover bg-center opacity-90 transition-opacity duration-700"
    data-alt="A sunlit, minimalist living room with high ceilings, featuring a beige linen sofa, a sculptural marble coffee table, and large arched windows casting long, dramatic shadows across wide-plank oak floors. The overall mood is serene, luxurious, and architectural, perfectly embodying modern, high-end interior design."
    style="background-image: url(&quot;https://lh3.googleusercontent.com/aida-public/AB6AXuAB-lYzfI8CvAVr7x4YCWlX72BrQaKERvA_Sl9bfm5EgTOWWOrSsbeqqBpHmig3FQHXOZWgxDvIv8ReCDm1zeHZLr0ufqhtRxqGFv7itgTgkC8AVRWP-7vyKU6TUqUk7Ux7AdgcB-irrx2RTkYzMko6Dtd81Nua8-7OyMWQnTxxBupl7y_RfchnqGu171opT_CjiPn21Q_z5b3GWbXNDH1HIzm_oP_uTPS_5FfcclQUWjZUCNuGmtMW5g&quot;);"
  >
    <div
      class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest/80 via-transparent to-transparent mix-blend-multiply"
    ></div>
  </div>
  <div
    class="relative z-10 w-full max-w-container-max mx-auto px-margin-mobile lg:px-gutter flex flex-col items-start pt-20"
  >
    <div
      class="bg-surface-container-lowest/80 backdrop-blur-xl p-12 md:p-16 max-w-3xl shadow-2xl rounded-lg border border-white/10 transform transition-all duration-700"
    >
      <h1
        class="font-bold text-4xl text-on-surface mb-8 uppercase tracking-[0.05em] leading-tight"
      >
        {{ section.settings.heading }}
      </h1>
      <p class="font-lg text-lg text-on-surface-variant mb-8 max-w-md">
        {{ section.settings.subheading }}
      </p>
      <a
        class="inline-flex items-center justify-center bg-primary text-on-primary px-10 py-5 font-label-sm text-sm uppercase tracking-[0.2em] hover:bg-on-background transition-all shadow-md hover:shadow-2xl border border-primary hover:border-on-background transform hover:-translate-y-1"
        href="{{ section.settings.button_link }}"
      >
        {{- section.settings.button_text -}}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ]
}
{% endschema %}
