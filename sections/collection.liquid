<div class="pt-20 flex flex-col w-full px-margin-mobile lg:px-gutter max-w-container-max mx-auto py-12">
  <!-- Breadcrumbs & Header -->
  <div class="mb-12 flex flex-col gap-6">
    <nav
      class="flex items-center gap-2 text-label-sm font-label-sm text-on-surface-variant uppercase tracking-widest"
    >
      <a class="hover:text-primary transition-colors" href="{{ routes.root_url }}">Home</a>
      <span class="text-outline-variant">/</span>
      <span class="text-primary font-bold">{{ collection.title }}</span>
    </nav>
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div class="flex flex-col gap-2">
        <h1 class="text-display-lg font-display-lg text-primary tracking-tighter">All Products</h1>
        <span class="text-body-md font-body-md text-on-surface-variant">
          {{- collection.products_count }} Curated Items</span
        >
      </div>
      <!-- Top Bar Sort -->
      <div
        class="flex items-center gap-4 border border-outline-variant px-4 py-2 bg-surface-container-lowest"
      >
        <span class="text-label-sm font-label-sm uppercase tracking-widest text-on-surface-variant">Sort By</span>
        <select
          0=""
          24=""
          24\

          black\
          class="bg-transparent text-body-md font-body-md text-primary outline-none appearance-none cursor-pointer pr-4"
          height="\&quot;24\&quot;"
          style="background-image: url('data:image/svg+xml;utf8,&lt;svg fill=\"
          viewbox="\&quot;0"
          width="\&quot;24\&quot;"
          xmlns="\&quot;http://www.w3.org/2000/svg\&quot;"
        >
          '); background-repeat: no-repeat; background-position-x: 100%; background-position-y: 50%;"&gt;
          <option value="featured">Featured</option>
          <option value="best-selling">Best Selling</option>
          <option value="price-low">Price: Low to High</option>
          <option value="price-high">Price: High to Low</option>
          <option value="newest">Newest</option>
        </select>
      </div>
    </div>
  </div>
  <!-- Main Layout -->
  <collection-filters data-section-id="{{ section.id }}" class="flex flex-col lg:flex-row gap-12 items-start">
    <!-- Sidebar Filters -->
    <aside class="w-full lg:w-64 flex-shrink-0 hidden lg:flex flex-col gap-8 sticky top-28">
      {% for filter in collection.filters %}
        <div class="flex flex-col gap-4 border-b border-surface-variant pb-6">
          <h3
            class="text-label-sm font-label-sm uppercase tracking-widest text-primary flex items-center justify-between cursor-pointer group"
          >
            {{ filter.label }}
            <span
              class="material-symbols-outlined text-on-surface-variant group-hover:text-primary transition-colors transition-transform duration-300"
              >expand_more</span
            >
          </h3>
          {% if filter.type == 'list' or filter.type == 'boolean' %}
            {% if filter.label == 'Color' %}
              <!-- Color Filter -->
              <div class="flex flex-wrap gap-3 pt-2">
                {% for value in filter.values %}
                  <label
                    class="w-8 h-8 rounded-full border border-outline-variant shadow-sm hover:scale-110 transition-transform focus:ring-2 ring-primary ring-offset-2 {% if value.active %} ring-2 ring-primary ring-offset-2 ring-offset-surface transition-all {% else %} hover:scale-110 transition-transform {% endif %}"
                    {% if value.swatch.color %}
                      style="background-color: {{ value.swatch.color }};"
                    {% else %}
                      style="background-image: url('{{ value.swatch.image | img_url: '100x100' }}'); background-size: cover; background-position: center;"
                    {% endif %}
                    for="{{ filter.id }}-{{ value.value }}"
                    title="{{ value.label }} ({{ value.count }})"
                  >
                  </label>
                  <input
                    id="{{ filter.id }}-{{ value.value }}"
                    type="checkbox"
                    name="{{ filter.label }}"
                    value="{{ value.value }}"
                    data-add-url="{{ value.url_to_add }}"
                    data-remove-url="{{ value.url_to_remove }}"
                    {% if value.active %}
                      checked
                    {% endif %}
                    class="hidden"
                  />
                {% endfor %}
              </div>
            {% else %}
              <!-- List Filter -->
              <ul class="flex flex-col gap-3">
                {% for value in filter.values %}
                  <li class="flex items-center gap-3">
                    <input
                      class="w-4 h-4 accent-primary cursor-pointer border-outline-variant"
                      id="{{ filter.id }}-{{ value.value }}"
                      type="checkbox"
                      name="{{ filter.label }}"
                      value="{{ value.value }}"
                      data-add-url="{{ value.url_to_add }}"
                      data-remove-url="{{ value.url_to_remove }}"
                      {% if value.active %}
                        checked
                      {% endif %}
                    >
                    <label
                      class="text-body-md font-body-md text-on-surface-variant hover:text-primary cursor-pointer transition-colors flex-1 flex justify-between"
                      for="{{ filter.id }}-{{ value.value }}"
                    >
                      {{ value.label }}
                      <span class="text-outline-variant text-label-sm">({{ value.count }})</span>
                    </label>
                  </li>
                {% endfor %}
              </ul>
            {% endif %}
          {% else %}
            {% if filter.min_value.value %}
              {% assign min_value = filter.min_value.value | divided_by: 100.0 %}
            {% else %}
              {% assign min_value = 0.0 %}
            {% endif %}

            {% if filter.max_value.value %}
              {% assign max_value = filter.max_value.value | divided_by: 100.0 %}
            {% else %}
              {% assign max_value = filter.range_max | divided_by: 100.0 %}
            {% endif %}

            <div class="flex flex-col gap-4 pt-2">
              <input
                class="w-full accent-primary h-1 bg-surface-variant appearance-none rounded-full outline-none"
                type="range"
                id="{{ filter.min_value.param_name }}"
                name="{{ filter.min_value.param_name }}"
                min="0"
                max="{{ filter.range_max | divided_by: 100 | round | plus: 1 }}"
                value="{{ min_value }}"
                data-param="{{ filter.min_value.param_name }}"
                data-min-value
              >
              <input
                class="w-full accent-primary h-1 bg-surface-variant appearance-none rounded-full outline-none"
                type="range"
                id="{{ filter.max_value.param_name }}"
                name="{{ filter.max_value.param_name }}"
                min="0"
                max="{{ filter.range_max | divided_by: 100 | round | plus: 1 }}"
                value="{{ max_value }}"
                data-param="{{ filter.max_value.param_name }}"
                data-max-value
              >

              <div class="flex items-center justify-between gap-4">
                <div
                  class="border border-outline-variant px-3 py-2 flex items-center gap-1 w-full bg-surface-container-lowest"
                >
                  <span class="text-label-sm font-label-sm text-on-surface-variant">$</span>
                  <input
                    class="w-full text-body-md font-body-md text-primary outline-none bg-transparent"
                    min="0"
                    type="number"
                    value="0"
                  >
                </div>
                <span class="text-on-surface-variant">-</span>
                <div
                  class="border border-outline-variant px-3 py-2 flex items-center gap-1 w-full bg-surface-container-lowest"
                >
                  <span class="text-label-sm font-label-sm text-on-surface-variant">$</span>
                  <input
                    class="w-full text-body-md font-body-md text-primary outline-none bg-transparent"
                    type="number"
                    value="1000"
                  >
                </div>
              </div>
            </div>
          {% endif %}
        </div>
      {%- endfor %}

      <button
        class="text-label-sm font-label-sm uppercase tracking-widest text-on-surface-variant hover:text-primary text-left transition-colors mt-2 underline decoration-1 underline-offset-4"
      >
        Clear All Filters
      </button>
    </aside>
    <!-- Product Grid -->
    <div class="flex-1 flex flex-col gap-12" id="collection-products">
      <!-- Mobile Filter Toggle (hidden on lg) -->
      <button
        class="lg:hidden w-full flex items-center justify-center gap-2 border border-outline-variant py-3 bg-surface-container-lowest text-label-sm font-label-sm uppercase tracking-widest text-primary hover:bg-surface transition-colors"
      >
        <span class="material-symbols-outlined text-[18px]">tune</span>
        Filter &amp; Sort
      </button>
      <!-- 4 Column Grid on XL, 3 on LG, 2 on MD, 1 on Mobile -->
      {% paginate collection.products by 20 %}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-x-8 gap-y-16">
          {% for product in collection.products %}
            <!-- Product Card -->
            <div class="group flex flex-col gap-4 relative">
              <div class="relative aspect-[4/5] bg-surface-container overflow-hidden rounded-sm">
                <img
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  data-alt="{{ product.title }}"
                  src="{{ product.featured_image | img_url: '400x' }}"
                  height="400"
                  width="400"
                >
                <!-- Badges -->
                {% comment %}
                  <div class="absolute top-4 left-4 flex flex-col gap-2">
                    <span
                      class="bg-secondary text-on-secondary px-3 py-1 text-[10px] font-label-sm uppercase tracking-widest shadow-sm"
                      >New In</span
                    >
                  </div>
                {% endcomment %}
                <!-- Wishlist -->
                <button
                  class="absolute top-4 right-4 w-8 h-8 bg-surface-container-lowest rounded-full flex items-center justify-center text-on-surface-variant hover:text-error hover:bg-error-container transition-all shadow-sm opacity-0 group-hover:opacity-100 translate-y-2 group-hover:translate-y-0 duration-300"
                >
                  <span class="material-symbols-outlined text-[18px]">favorite</span>
                </button>
                <!-- Quick Add -->
                {% form 'product', product %}
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" />
                  <input type="hidden" name="quantity" value="1" />

                  <button
                    type="submit"
                    class="absolute bottom-0 left-0 w-full bg-primary/95 text-on-primary py-4 text-label-sm font-label-sm uppercase tracking-widest translate-y-full group-hover:translate-y-0 transition-transform duration-300 hover:bg-primary backdrop-blur-md"
                  >
                    Quick Add
                  </button>
                {% endform %}
              </div>
              <div class="flex flex-col gap-1">
                <a
                  class="text-body-lg font-body-lg text-primary hover:text-on-surface-variant transition-colors line-clamp-1"
                  href="{{ product.url }}"
                >
                  {{ product.title }}
                </a>
                <div class="flex flex-wrap items-center gap-2">
                  <span class="text-body-md font-body-md text-primary">{{ product.price | money }}</span>
                </div>
                <span class="text-label-sm font-label-sm text-on-surface-variant mt-1">
                  {{- product.collections.first.title -}}
                </span>
              </div>
            </div>
          {% endfor %}
        </div>
        <!-- Pagination / Load More -->
        <div class="flex items-center justify-center gap-2 mt-section-gap">
          {% if paginate.previous %}
            <a
              href="{{ paginate.previous.url }}"
              class="w-10 h-10 flex items-center justify-center rounded-full border border-outline-variant text-on-surface hover:bg-surface-variant transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
              disabled=""
            >
              <span class="material-symbols-outlined text-[20px]">chevron_left</span>
            </a>
          {% endif %}

          {% for part in paginate.parts %}
            {% if part.is_link %}
              <a
                href="{{ part.url }}"
                class="w-10 h-10 flex items-center justify-center rounded-full text-on-surface hover:bg-surface-variant transition-colors font-label-sm text-label-sm"
              >
                {{ part.title }}
              </a>
            {% else %}
              <button
                class="w-10 h-10 flex items-center justify-center rounded-full bg-primary text-on-primary font-label-sm text-label-sm"
              >
                {{ part.title }}
              </button>
            {% endif %}
          {% endfor %}

          {% if paginate.next %}
            <a
              href="{{ paginate.next.url }}"
              class="w-10 h-10 flex items-center justify-center rounded-full border border-outline-variant text-on-surface hover:bg-surface-variant transition-colors"
            >
              <span class="material-symbols-outlined text-[20px]">chevron_right</span>
            </a>
          {% endif %}
        </div>
      {% endpaginate %}
    </div>
  </collection-filters>
</div>

<script src="{{ 'collection-filters.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "t:general.collection",
  "settings": []
}
{% endschema %}
