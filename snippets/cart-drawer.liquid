<section
  class="cart-drawer fixed top-0 right-0 w-[350px] max-w-md h-full bg-white shadow-lg z-50 transform transition-transform duration-300 ease-in-out p-4 flex flex-col justify-between"
  id="cart-drawer"
>
  <div class="flex justify-between items-center mb-3 mt-2 border-b border-gray-500 pb-4 px-1 h-[50px]">
    <h3 class="text-2xl font-semibold text-gray-700">{{ 'cart.title' | t }}</h3>
    <button
      type="button"
      class="text-gray-600 hover:text-gray-800 focus:outline-none cursor-pointer"
      id="cart-drawer-close"
    >
      <span class="material-symbols-outlined text-[24px]">close</span>
    </button>
  </div>

  <div class="flex flex-col" id="cart-drawer-content">
    <div class="flex-grow overflow-y-auto h-[calc(100vh-275px)]">
      {% for item in cart.items %}
        <div class="flex items-center justify-between py-2">
          <div class="flex items-center w-full">
            <img
              src="{{ item.image | img_url: 'small' }}"
              alt="{{ item.title }}"
              class="w-16 h-16 object-cover rounded-md"
              height="{{ item.image.height }}"
              width="{{ item.image.width }}"
            >
            <div class="ml-3 grow">
              <h4 class="text-sm font-medium text-gray-800">{{ item.title }}</h4>
              <span class="text-sm text-gray-600">{{ item.variant_title | default: 'Default Variant' }}</span>
              <p class="text-sm text-gray-600">{{ item.price | money }}</p>
            </div>
            <cart-actions data-line="{{ forloop.index }}">
              <div class="flex flex-col items-center justify-center gap-1 ml-3">
                <div class="flex items-center justify-between border border-gray-300 rounded-md w-full px-1 py-1">
                  <button
                    type="button"
                    class="text-gray-600 text-xs hover:text-gray-800 focus:outline-none"
                    data-minus-action
                  >
                    <img
                      src="{{ 'minus.svg' | asset_url }}"
                      alt="Decrease quantity"
                      class="w-4 h-4"
                      height="16"
                      width="16"
                      data-quantity="{{ item.quantity | minus: 1 }}"
                    >
                  </button>
                  <span class="text-sm text-gray-800">{{ item.quantity }}</span>
                  <button
                    type="button"
                    class="text-gray-600 text-xs hover:text-gray-800 focus:outline-none"
                    data-plus-action
                  >
                    <img
                      src="{{ 'plus.svg' | asset_url }}"
                      alt="Increase quantity"
                      class="w-4 h-4"
                      height="16"
                      width="16"
                      data-quantity="{{ item.quantity | plus: 1 }}"
                    >
                  </button>
                </div>

                <button
                  type="button"
                  class="text-gray-600 hover:bg-gray-700 focus:outline-none flex items-center justify-center text-xs bg-gray-900 text-white py-1 px-2 rounded-sm w-full cursor-pointer"
                  data-remove-action
                >
                  <span class="text-sm" data-quantity="{{ 0 }}">Remove</span>
                </button>
              </div>
            </cart-actions>
          </div>
        </div>
      {% endfor %}

      {% if cart.item_count == 0 %}
        <div class="text-center py-8 h-full flex items-center justify-center">
          <p class="text-gray-500">Your cart is empty</p>
        </div>
      {% endif %}
    </div>

    <div class="mt-4 border-t border-gray-500 pt-4 h-[165px]">
      <div class="flex justify-between items-center mb-2">
        <span class="text-lg">Estimated Total</span>
        <span class="text-2xl font-bold">{{ cart.total_price | money }}</span>
      </div>
      <span class="text-sm text-gray-600 mt-5">Shipping & taxes calculated at checkout</span>
      {% if cart.item_count == 0 %}
        <button
          class="block w-full text-center bg-gray-500 text-white py-3 transition-colors duration-300 uppercase mt-7 text-md"
          disabled
        >
          Proceed to Checkout
        </button>
      {% else %}
        <a
          href="{{ routes.cart_url }}"
          class="block w-full text-center bg-black text-white py-3 hover:bg-gray-800 transition-colors duration-300 uppercase mt-7 text-md"
        >
          Proceed to Checkout
        </a>
      {% endif %}
    </div>
  </div>
</section>

<script src="{{ 'cart-drawer.js' | asset_url }}" defer></script>
